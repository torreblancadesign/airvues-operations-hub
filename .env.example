# Airvues Ops local environment
# Copy to .env.local and fill in real values. Never commit .env.local.

# Local preview
# Skips auth only in non-production. Useful for UI work on protected pages.
DEV_PREVIEW=true
# Emergency auth kill switch. Do not enable in production.
AUTH_BYPASS=false

# Airtable - required for real dashboard data
AIRTABLE_BASE_ID=app4vhhWMbRFOloOU
AIRTABLE_TOKEN=

# NextAuth / Google OAuth - required for real sign-in flows
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Use your active local port, for example http://localhost:3000 or http://localhost:3002
NEXTAUTH_URL=http://localhost:3000
# JSON array of email/domain role rules.
# Example: [{"email":"person@example.com","role":"admin"},{"domain":"airvues.com","role":"engineer"}]
ALLOWED_USERS=[]

# People identity mapping - optional
# Map sign-in email to canonical Airtable People recId.
PERSON_OVERRIDES={}
# Map alternate email to canonical email.
PERSON_EMAIL_ALIASES={}

# Uploads / recordings - required for Loops, Meetings, Leads, and Quotes uploads
BLOB_READ_WRITE_TOKEN=

# AI transcription - required to regenerate Loop/Meeting transcripts and summaries
LOVABLE_API_KEY=

# Quote app SSO - optional
QUOTE_SSO_SECRET=

# Client portal - required for magic-link sign-in
# Signs portal links (30 min) and portal session cookies (8 h).
# Rotating it invalidates every outstanding link and session at once,
# without touching ops sign-in. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORTAL_SESSION_SECRET=

# Legacy SAML - optional/dormant unless AUTH_METHOD=saml
AUTH_METHOD=
SAML_SP_ENTITY_ID=
SAML_SP_ACS_URL=
SAML_SP_KEY=
SAML_SP_CERT=
SAML_IDP_SSO_URL=
SAML_IDP_ENTITY_ID=
SAML_IDP_CERT=
SAML_IDP_INITIATED_URL=
SAML_GROUP_ADMIN=airvues-ops-admin@airvues.com
SAML_GROUP_EDITOR=airvues-ops-editor@airvues.com
SAML_GROUP_VIEWER=airvues-ops-viewer@airvues.com
SAML_DEFAULT_ROLE=deny
